# Copia este archivo como `.env` (en la carpeta backend) y rellena los valores.
# NO subas el archivo `.env` al repositorio.

# Puerto del backend (el frontend espera http://localhost:3001/api)
PORT=3001

# Origen permitido para CORS (el frontend en desarrollo)
CORS_ORIGIN=http://localhost:3000

# Autenticación
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES_IN=1d

# Base de datos PostgreSQL (usa las credenciales de tu BD de pruebas/producción)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false

# Pool de conexiones (opcional; valores por defecto: 30 / 2)
DB_POOL_MAX=30
DB_POOL_MIN=2

# Integración de listas de precios (opcional)
LISTAS_PRECIOS_URL=https://apiconsulta.grupo-santacruz.com/listas-precios
