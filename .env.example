# ============================================================
#  Variables de entorno para producción (Dokploy / docker-compose)
#  Copia este archivo como .env y completa los valores reales,
#  o defínelos en el panel de Dokploy. NO subas el .env real.
# ============================================================

# ---------- Frontend ----------
# URL pública del backend (incluye /api). Se usa en el BUILD del frontend.
NEXT_PUBLIC_API_URL=https://api.tudominio.com/api

# ---------- Backend · CORS ----------
# Dominio público del frontend permitido para peticiones.
CORS_ORIGIN=https://tudominio.com

# ---------- Backend · Autenticación ----------
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1d

# ---------- Backend · SSO (inicio de sesión desde la suite SCTOOLS) ----------
# URL base del backend de la suite. En dev suele ser http://localhost:8000
SSO_ISSUER_URL=http://localhost:8000
# Secreto compartido con la suite. Debe ser IDÉNTICO al SSO_SHARED_SECRET de SCTOOLS.
SSO_SHARED_SECRET=

# ---------- Backend · Base de datos PostgreSQL ----------
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false

# ---------- Backend · Integraciones ----------
LISTAS_PRECIOS_URL=https://apiconsulta.grupo-santacruz.com/listas-precios
